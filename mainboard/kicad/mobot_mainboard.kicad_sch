	(text "Caps per datasheet Table 80: C304 = C1 (VREGD), C305 = C2 (VREGA), C306 = C3 (V3P3 pin 17), C307 = C4 (V3P3 pin 8),"
		(exclude_from_sim no)
		(at 835.66 297.18 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "1715b9ec-d757-4e99-a5d5-44bd0e0f5024")
	)
	(text "C308 = C5 (VDDIO). Place each at its pin on the top layer, ESR < 100 mOhm. SPI mode 0, <= 10.5 MHz."
		(exclude_from_sim no)
		(at 835.66 299.72 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "18614608-4449-410c-a740-e8d104ccddb5")
	)
	(text "DRY_SYNC used as SYNC input (S3 = time master). TA8/TA9 = GND, pins 5/7 GND, pin 2 open, no center pad."
		(exclude_from_sim no)
		(at 835.66 302.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left bottom)
		)
		(uuid "df8b4540-a6e1-4a92-8635-8816095bf65c")
	)
